<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="be-backend-sso" type="AzureFunctionAppRun" factoryName="Azure - Run Function">
    <!-- Loady.Backend.Api, the sso variant of be-backend: same project and port, the Dev launch
         profile so appsettings.Development.json applies and sign-in goes through the real dev B2C
         tenant, and the envs below to point the infrastructure back at this machine.
         TRACK_ENVS=0 is what makes them win over the profile's own.
         Needs an az device-code login on the VM: Key Vault, Azure Search and the blob
         accounts are not overridden and use DefaultAzureCredential. -->
